# Backend configuration — copy to backend/.env and fill in.
# Everything here is read once at startup by config.py into a validated Settings
# object. Never commit a filled-in .env (it is git-ignored).

# --- AI provider keys (at least one of the first three is required to generate) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Image generation / editing / background removal (this key is .env-only).
REPLICATE_API_KEY=
# Optional OpenAI-compatible proxy base URL (ignored when IS_PROD=true).
OPENAI_BASE_URL=

# --- feature flags (strict booleans: 1/true/yes/on vs 0/false/no/off) ---
IS_PROD=false
IS_DEBUG_ENABLED=false
# Full per-run capture (JSONL + SQLite + HTML snapshots) under run_logs/.
PROMPT_REPORTS_ENABLED=false

# --- HTTP / CORS ---
# Comma-separated exact origins allowed to call the API. Defaults to the local
# dev origins (localhost/127.0.0.1 on :5173 and :5180). No wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180

# --- operator gate for internal /evals, /agent-runs, /prompt-reports, /eval-* ---
# Secure default: those endpoints are DISABLED until you do one of:
#  (a) set OPERATOR_TOKEN and send it as the "X-Operator-Token" request header, or
#  (b) set OPERATOR_ENDPOINTS_PUBLIC=true (local development only).
OPERATOR_TOKEN=
OPERATOR_ENDPOINTS_PUBLIC=false

# --- logging ---
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: console (key=value, human) | json
LOG_FORMAT=console

# --- infrastructure (Batch 2: DB + queue foundation) ---
# PostgreSQL. Unset => DB disabled, screenshot->code generation still works.
# `docker compose up -d postgres redis` starts these on 127.0.0.1:5435 / :6379.
DATABASE_URL=postgresql+asyncpg://appbuilder:appbuilder@127.0.0.1:5435/appbuilder
REDIS_URL=redis://127.0.0.1:6379/0
# When true, the migrated text->create generation path runs through the
# Redis/arq worker (needs a running worker). All other paths stay synchronous.
JOB_QUEUE_ENABLED=false
# Worker retry cap and per-job wall-clock watchdog (seconds). arq enforces
# JOB_TIMEOUT_SECONDS in-process for a hung job on a live worker.
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=900
# Out-of-process watchdog: a job left 'running' this long is reaped to 'failed'
# by the worker's reap_jobs cron (every 5 min) — covers a worker killed mid-job.
# Must exceed JOB_TIMEOUT_SECONDS. 0 disables the reaper.
JOB_REAP_AFTER_SECONDS=3600
# Opt-in job retention: unset = never prune. A positive integer = the worker's
# daily prune_jobs cron deletes terminal job rows older than N days (queued /
# running rows are never touched).
# JOB_RETENTION_DAYS=
# How often the worker refreshes its arq health-check key; /health reports the
# worker as "down" once this lapses.
WORKER_HEALTH_INTERVAL_SECONDS=30
# WORKER_NAME=          # defaults to worker@<host>:<pid>

# --- docker compose overrides (non-secret local dev defaults) ---
# POSTGRES_USER=appbuilder
# POSTGRES_PASSWORD=appbuilder
# POSTGRES_DB=appbuilder
# POSTGRES_PORT=5435
# REDIS_PORT=6379

# --- misc (defaults are usually fine) ---
# NUM_VARIANTS=4
# NUM_VARIANTS_VIDEO=2
# GENERATION_MAX_COST_USD=3.0
# LOCAL_ASSET_DIR=
# LOCAL_ASSET_BASE_URL=http://127.0.0.1:7001
# SCREENSHOT_TO_CODE_DATA_DIR=
# LOGS_PATH=
# EVALS_DIR=./evals_data
